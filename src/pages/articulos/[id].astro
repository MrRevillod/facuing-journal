---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Cover from "../../components/Cover.astro";
import {
  articleUrl,
  authorLine,
  citation,
  doiLabel,
  formatDate,
  issueFullLabel,
  issueLabel,
  issueUrl,
  pageRange,
  summary,
} from "../../lib/journal";
import { articles, issues, type Article } from "../../data/journal";

export function getStaticPaths() {
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const currentIssue = issues.find((item) => item.id === article.issueId);
const related = articles
  .filter((item) => item.issueId === article.issueId && item.id !== article.id)
  .slice(0, 3);

const exportData = {
  id: article.id,
  title: article.title,
  authors: article.authors.map((author) => author.name),
  journal: "Revista de Ingeniería UCT",
  year: currentIssue?.year ?? Number(article.publishedAt.slice(0, 4)),
  volume: currentIssue?.volume ?? "",
  number: currentIssue?.number ?? "",
  firstPage: article.pages.split("-")[0] ?? "",
  lastPage: article.pages.split("-")[1] ?? "",
  date: article.publishedAt,
  doi: article.doi,
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: article.title,
  datePublished: article.publishedAt,
  author: article.authors.map((author) => ({ "@type": "Person", name: author.name })),
  isPartOf: {
    "@type": "PublicationIssue",
    issueNumber: String(currentIssue?.number ?? ""),
    datePublished: currentIssue?.publishedAt,
  },
  ...(article.doi ? { identifier: article.doi } : {}),
  pagination: article.pages,
  inLanguage: "es",
};
---

<BaseLayout
  title={`${article.title} | Revista de Ingeniería UCT`}
  description={summary(article.abstractEs)}
  active="/numeros/"
  type="article"
>
  <Fragment slot="head">
    <meta name="citation_title" content={article.title} />
    {
      article.authors.map((author) => (
        <meta name="citation_author" content={author.name} />
      ))
    }
    <meta name="citation_publication_date" content={article.publishedAt} />
    <meta name="citation_journal_title" content="Revista de Ingeniería UCT" />
    {article.doi && <meta name="citation_doi" content={article.doi} />}
    {currentIssue && (
      <meta name="citation_volume" content={String(currentIssue.volume)} />
    )}
    {currentIssue && (
      <meta name="citation_issue" content={String(currentIssue.number)} />
    )}
    <meta name="citation_firstpage" content={article.pages.split("-")[0]} />
    <meta name="citation_lastpage" content={article.pages.split("-")[1] ?? ""} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <nav class="flex flex-wrap items-center gap-2 py-6 text-[11px] text-muted">
    <a href="/" class="underline decoration-line underline-offset-2 hover:text-ink">Inicio</a>
    <span class="text-line">/</span>
    <a href="/numeros/" class="underline decoration-line underline-offset-2 hover:text-ink">Números</a>
    <span class="text-line">/</span>
    {currentIssue && (
      <a href={issueUrl(currentIssue)} class="underline decoration-line underline-offset-2 hover:text-ink">
        {issueFullLabel(currentIssue)}
      </a>
    )}
    <span class="text-line">/</span>
    <span>Artículo</span>
  </nav>

  <div class="grid gap-12 border-t border-line py-10 lg:grid-cols-[minmax(0,1fr)_300px]">
    <article class="min-w-0">
      <h1 class="font-serif text-[30px] leading-[1.18] tracking-[-0.01em] sm:text-[34px]">
        {article.title}
      </h1>

      <div class="mt-6 space-y-3 border-l border-line pl-4">
        {
          article.authors.map((author) => (
            <div class="text-[14px] leading-snug">
              <span class="text-ink">{author.name}</span>
              {author.corresponding && (
                <span class="ml-2 text-[11px] uppercase tracking-[0.12em] text-accent">
                  Correspondencia
                </span>
              )}
              {author.orcid && (
                <span class="ml-2 text-[11px] uppercase tracking-[0.12em] text-muted">
                  ORCID {author.orcid.replace(/^https?:\/\/orcid\.org\//, "")}
                </span>
              )}
              {author.affiliation && (
                <span class="mt-0.5 block text-[11px] leading-snug text-muted">
                  {author.affiliation}
                </span>
              )}
              {author.corresponding && author.email && (
                <a
                  href={`mailto:${author.email}`}
                  class="mt-0.5 block text-[11px] text-muted underline decoration-line underline-offset-2 hover:text-ink"
                >
                  {author.email}
                </a>
              )}
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-[12px] text-muted">
        {[
          article.section,
          currentIssue ? issueLabel(currentIssue) : "",
          article.pages ? `pp. ${pageRange(article.pages)}` : "",
          formatDate(article.publishedAt),
          article.license,
        ]
          .filter(Boolean)
          .join("  ·  ")}
      </p>

      <div class="mt-8 border-t border-line pt-6">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted">Resumen</h2>
        <p class="mt-3 max-w-[68ch] font-serif text-[16px] leading-[1.7] text-ink/90">
          {article.abstractEs}
        </p>
      </div>

      <div class="mt-8 border-t border-line pt-6">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted">Abstract</h2>
        <p lang="en" class="mt-3 max-w-[68ch] font-serif text-[16px] leading-[1.7] text-ink/90">
          {article.abstractEn}
        </p>
      </div>

      <div class="mt-8 border-t border-line pt-5">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted">Palabras clave</h2>
        <p class="mt-2 text-[13px] leading-relaxed text-ink/80">{article.keywordsEs.join(" · ")}</p>
        <p class="mt-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-muted">Keywords</p>
        <p lang="en" class="mt-2 text-[13px] leading-relaxed text-ink/80">{article.keywordsEn.join(" · ")}</p>
      </div>
    </article>

    <aside class="min-w-0 lg:sticky lg:top-[calc(var(--header-h)+1.5rem)] lg:self-start lg:border-l lg:border-line lg:pl-8">
      {currentIssue && (
        <div class="max-w-[170px]">
          <Cover issue={currentIssue} />
        </div>
      )}

      <h2 class="mt-6 text-[11px] font-semibold uppercase tracking-[0.18em] text-muted">Ficha</h2>
      <dl class="mt-3 text-[12px]">
        <div class="grid grid-cols-[72px_1fr] gap-3 border-b border-line py-2">
          <dt class="text-muted">Número</dt>
          <dd class="text-ink">{currentIssue ? issueFullLabel(currentIssue) : "—"}</dd>
        </div>
        <div class="grid grid-cols-[72px_1fr] gap-3 border-b border-line py-2">
          <dt class="text-muted">Sección</dt>
          <dd class="text-ink">{article.section}</dd>
        </div>
        <div class="grid grid-cols-[72px_1fr] gap-3 border-b border-line py-2">
          <dt class="text-muted">Páginas</dt>
          <dd class="text-ink">{article.pages ? pageRange(article.pages) : "—"}</dd>
        </div>
        <div class="grid grid-cols-[72px_1fr] gap-3 border-b border-line py-2">
          <dt class="text-muted">Recibido</dt>
          <dd class="text-ink">{formatDate(article.receivedAt)}</dd>
        </div>
        <div class="grid grid-cols-[72px_1fr] gap-3 border-b border-line py-2">
          <dt class="text-muted">Aceptado</dt>
          <dd class="text-ink">{formatDate(article.acceptedAt)}</dd>
        </div>
        <div class="grid grid-cols-[72px_1fr] gap-3 border-b border-line py-2">
          <dt class="text-muted">Publicado</dt>
          <dd class="text-ink">{formatDate(article.publishedAt)}</dd>
        </div>
        <div class="grid grid-cols-[72px_1fr] gap-3 border-b border-line py-2">
          <dt class="text-muted">DOI</dt>
          <dd class="text-ink">{article.doi ? doiLabel(article.doi) : "En trámite"}</dd>
        </div>
        <div class="grid grid-cols-[72px_1fr] gap-3 py-2">
          <dt class="text-muted">Licencia</dt>
          <dd class="text-ink">{article.license}</dd>
        </div>
      </dl>

      <div class="mt-4 flex flex-col gap-2">
        <a
          href={article.pdf}
          data-sample-doc
          class="flex w-full items-center justify-center rounded-sm bg-accent px-4 py-2.5 text-[12px] font-medium tracking-wide text-white transition hover:bg-[#00679e]"
        >
          Descargar PDF
        </a>
        <a
          href={article.html}
          data-sample-doc
          class="flex w-full items-center justify-center border border-line px-4 py-2.5 text-[12px] tracking-wide text-muted transition hover:border-ink hover:text-ink"
        >
          Ver HTML
        </a>
      </div>

      <div class="mt-6 border-t border-line pt-4">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-muted">Cómo citar</h2>
        <p id="citation" class="mt-2 break-words font-serif text-[12.5px] leading-relaxed text-ink/80">
          {citation(article)}
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px]">
          <button
            id="copy-citation"
            type="button"
            class="text-accent underline decoration-accent/30 underline-offset-4 transition hover:decoration-accent"
          >
            Copiar cita
          </button>
          <button
            type="button"
            data-export="ris"
            class="text-muted underline decoration-line underline-offset-4 transition hover:text-ink hover:decoration-ink"
          >
            Descargar RIS
          </button>
          <button
            type="button"
            data-export="bibtex"
            class="text-muted underline decoration-line underline-offset-4 transition hover:text-ink hover:decoration-ink"
          >
            Descargar BibTeX
          </button>
        </div>
      </div>
    </aside>
  </div>

  <section class="border-t border-line py-10">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <h2 class="font-serif text-[22px] text-ink">También en este número</h2>
      <a
        href={currentIssue ? issueUrl(currentIssue) : "/numeros/"}
        class="text-[12px] text-muted underline decoration-line underline-offset-4 transition hover:text-ink hover:decoration-ink"
      >
        Ver sumario
      </a>
    </div>
    <ul class="divide-y divide-line">
      {
        related.map((item) => (
          <li class="py-4">
            <a
              href={articleUrl(item)}
              class="font-serif text-[17px] leading-snug text-ink underline decoration-transparent underline-offset-2 transition hover:decoration-ink"
            >
              {item.title}
            </a>
            <p class="mt-1 text-[12px] text-muted">
              {authorLine(item.authors, 4)} · pp. {pageRange(item.pages)}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <script type="application/json" id="citation-export" set:html={JSON.stringify(exportData)} />

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const button = document.getElementById("copy-citation") as HTMLButtonElement | null;
      const citationEl = document.getElementById("citation");
      const dataEl = document.getElementById("citation-export");
      if (!dataEl) return;

      const data = JSON.parse(dataEl.textContent || "{}") as {
        id: string;
        title: string;
        authors: string[];
        journal: string;
        year: number;
        volume: number | string;
        number: number | string;
        firstPage: string;
        lastPage: string;
        date: string;
        doi: string;
      };

      const download = (name: string, content: string, type: string) => {
        const url = URL.createObjectURL(new Blob([content], { type }));
        const link = document.createElement("a");
        link.href = url;
        link.download = name;
        link.click();
        URL.revokeObjectURL(url);
      };

      button?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(citationEl?.textContent?.trim() ?? "");
          button.textContent = "Cita copiada";
          setTimeout(() => (button.textContent = "Copiar cita"), 1600);
        } catch {
          button.textContent = "No se pudo copiar";
        }
      });

      const ris = () =>
        [
          "TY  - JOUR",
          ...data.authors.map((name) => `AU  - ${name}`),
          `TI  - ${data.title}`,
          `JO  - ${data.journal}`,
          `VL  - ${data.volume}`,
          `IS  - ${data.number}`,
          `SP  - ${data.firstPage}`,
          `EP  - ${data.lastPage}`,
          `PY  - ${data.year}`,
          `DA  - ${data.date.replace(/-/g, "/")}`,
          ...(data.doi ? [`DO  - ${data.doi}`] : []),
          "ER  - ",
        ].join("\r\n");

      const bibtex = () =>
        [
          `@article{riuct${data.year}${data.id.replace(/[^a-z0-9]/gi, "")},`,
          `  author  = {${data.authors.join(" and ")}},`,
          `  title   = {${data.title}},`,
          `  journal = {${data.journal}},`,
          `  year    = {${data.year}},`,
          `  volume  = {${data.volume}},`,
          `  number  = {${data.number}},`,
          `  pages   = {${data.firstPage}--${data.lastPage}}${data.doi ? "," : ""}`,
          ...(data.doi ? [`  doi     = {${data.doi}}`] : []),
          "}",
        ].join("\n");

      document.querySelectorAll<HTMLButtonElement>("[data-export]").forEach((el) => {
        el.addEventListener("click", () => {
          const kind = el.dataset.export;
          if (kind === "ris") download(`riuct-${data.id}.ris`, ris(), "application/x-research-info-systems");
          if (kind === "bibtex") download(`riuct-${data.id}.bib`, bibtex(), "application/x-bibtex");
        });
      });
    });
  </script>
</BaseLayout>
