---
import BaseLayout from "../layouts/BaseLayout.astro";
import Search from "../components/Search.svelte";
import { articles, issues } from "../data/journal";
import { issueFullLabel, sortedIssues } from "../lib/journal";

const items = articles.map((article) => {
  const issue = issues.find((item) => item.id === article.issueId);
  return {
    id: article.id,
    title: article.title,
    section: article.section,
    year: issue?.year ?? null,
    issueId: article.issueId,
    issue: issue ? issueFullLabel(issue) : "",
    pages: article.pages,
    doi: article.doi,
    authors: article.authors.map((author) => author.name),
    text: [
      article.title,
      article.abstractEs,
      article.abstractEn,
      ...article.keywordsEs,
      ...article.keywordsEn,
      ...article.authors.map((author) => author.name),
      issue ? issueFullLabel(issue) : "",
    ]
      .join(" ")
      .toLowerCase(),
  };
});

const years = [...new Set(issues.map((issue) => String(issue.year)))].sort(
  (a, b) => Number(b) - Number(a)
);
const sections = [...new Set(articles.map((article) => article.section))].sort();
const issueOptions = sortedIssues().map((issue) => ({
  id: issue.id,
  label: issueFullLabel(issue),
}));

const params = Astro.url.searchParams;
const initial = {
  q: params.get("q") ?? "",
  year: params.get("year") ?? "",
  section: params.get("section") ?? "",
  issue: params.get("issue") ?? "",
};
---

<BaseLayout
  title="Buscar — Revista de Ingeniería UCT"
  description="Buscador de artículos de la Revista de Ingeniería UCT."
  active="/buscar/"
>
  <section class="py-10">
    <h1 class="font-serif text-[32px] leading-tight tracking-[-0.01em]">Buscar artículos</h1>
    <p class="mt-3 max-w-[62ch] text-[14px] leading-relaxed text-muted">
      Busca por título, autor, palabra clave o número. Los resultados corresponden al contenido
      publicado en la revista.
    </p>
  </section>

  <Search
    client:load
    items={items}
    years={years}
    sections={sections}
    issues={issueOptions}
    initial={initial}
  />
</BaseLayout>
