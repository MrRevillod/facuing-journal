---
import { meta } from "../data/journal";
import { currentIssue, issueUrl } from "../lib/journal";

interface Props {
    active?: string;
    brandAsHeading?: boolean;
}

const { active = "", brandAsHeading = false } = Astro.props;
const Brand = brandAsHeading ? "h1" : "span";
const current = currentIssue();

const nav = [
    ["/", "Inicio"],
    [issueUrl(current), "Actual"],
    ["/numeros/", "Números"],
    ["/autores/", "Autores"],
    ["/acerca/", "Acerca"],
    ["/buscar/", "Buscar"],
    ["/enviar/", "Enviar artículo"],
];
---

<header class="border-b border-line bg-paper">
    <div class="mx-auto max-w-6xl px-6">
        <div class="flex flex-col gap-3 py-8 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
            <div class="flex items-center justify-between gap-4">
                <a href="/" class="flex shrink-0 items-center gap-4">
                    <img
                        src="/assets/logo-uct.webp"
                        alt="Universidad Católica de Temuco"
                        class="h-8 w-8 object-contain"
                    />
                    <span class="flex flex-col">
                        <Brand class="font-serif text-[20px] leading-none tracking-[-0.01em] text-ink sm:text-[24px]">
                            {meta.shortName}
                        </Brand>
                        <span class="mt-1.5 text-[11px] font-medium uppercase tracking-[0.12em] text-muted">
                            {meta.faculty} · UCT
                        </span>
                    </span>
                </a>

                <button
                    type="button"
                    data-nav-toggle
                    aria-expanded="false"
                    aria-controls="site-nav"
                    class="inline-flex items-center gap-1.5 border border-line px-3 py-1.5 text-[11px] uppercase tracking-[0.12em] text-muted transition hover:border-ink hover:text-ink sm:hidden"
                >
                    Menú
                    <svg
                        class="size-3"
                        viewBox="0 0 12 12"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.4"
                        aria-hidden="true"
                    >
                        <path
                            d="m2.5 4.5 3.5 3.5 3.5-3.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </button>
            </div>

            <nav
                id="site-nav"
                class="hidden flex-col gap-3 border-t border-line pt-4 text-[13px] sm:flex sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6 sm:gap-y-1 sm:border-0 sm:pt-0 sm:justify-end"
            >
                {nav.map(([href, label]) => {
                    const isCta = href === "/enviar/";
                    const isActive = active === href;
                    if (isCta) {
                        return (
                            <a
                                href={href}
                                class="inline-flex min-h-6 items-center border-b-2 border-accent pb-0.5 font-medium text-accent transition hover:border-ink hover:text-ink"
                            >
                                {label}
                            </a>
                        );
                    }
                    return (
                        <a
                            href={href}
                            class:list={[
                                "inline-flex min-h-6 items-center border-b-2 pb-0.5 transition",
                                isActive
                                    ? "border-accent text-ink"
                                    : "border-transparent text-muted hover:border-line hover:text-ink",
                            ]}
                        >
                            {label}
                        </a>
                    );
                })}
            </nav>
        </div>
    </div>
</header>

<script>
    const toggle =
        document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const panel = document.querySelector<HTMLElement>("#site-nav");

    toggle?.addEventListener("click", () => {
        if (!panel) return;
        const opening = panel.classList.contains("hidden");
        panel.classList.toggle("hidden", !opening);
        panel.classList.toggle("flex", opening);
        toggle.setAttribute("aria-expanded", String(opening));
        window.dispatchEvent(new Event("site-header-toggle"));
    });
</script>
