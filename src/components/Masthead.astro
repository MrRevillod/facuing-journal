---
import { meta } from "../data/journal";
import { currentIssue, issueUrl } from "../lib/journal";

interface Props {
    active?: string;
}

const { active = "" } = Astro.props;
const current = currentIssue();

const nav = [
    ["/", "Inicio"],
    [issueUrl(current), "Actual"],
    ["/numeros/", "Números"],
    ["/autores/", "Autores"],
    ["/acerca/", "Acerca"],
    ["/buscar/", "Buscar"],
    ["/enviar/", "Enviar artículo"],
];
---

<header class="border-b border-line bg-paper py-4">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-8 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-0">
        <a href="/" class="flex shrink-0 items-center gap-4">
            <img
                src="/assets/logo-uct.webp"
                alt="Universidad Católica de Temuco"
                class="h-8 w-8 object-contain"
            />
            <span class="flex flex-col">
                <span class="font-serif text-[20px] leading-none tracking-[-0.01em] text-ink sm:text-[24px]">
                    {meta.shortName}
                </span>
                <span class="mt-1.5 text-[11px] font-medium uppercase tracking-[0.12em] text-muted">
                    {meta.faculty} · UCT
                </span>
            </span>
        </a>

        <nav class="flex flex-wrap items-center gap-x-6 gap-y-1 text-[13px] sm:justify-end">
            {nav.map(([href, label]) => {
                const isCta = href === "/enviar/";
                const isActive = active === href;
                if (isCta) {
                    return (
                        <a
                            href={href}
                            class="inline-flex min-h-6 items-center border-b-2 border-accent pb-0.5 font-medium text-accent transition hover:border-ink hover:text-ink"
                        >
                            {label}
                        </a>
                    );
                }
                return (
                    <a
                        href={href}
                        class:list={[
                            "inline-flex min-h-6 items-center border-b-2 pb-0.5 transition",
                            isActive
                                ? "border-accent text-ink"
                                : "border-transparent text-muted hover:border-line hover:text-ink",
                        ]}
                    >
                        {label}
                    </a>
                );
            })}
        </nav>
    </div>
</header>
