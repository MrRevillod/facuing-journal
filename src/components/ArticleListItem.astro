---
import type { Article } from "../data/journal";
import { articleUrl, authorLine, doiLabel, pageRange } from "../lib/journal";

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<li class="border-t border-line py-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <a
      href={articleUrl(article)}
      class="min-w-0 flex-1 font-serif text-[18px] leading-snug text-ink underline decoration-transparent underline-offset-2 transition hover:decoration-ink"
    >
      {article.title}
    </a>
    <span class="shrink-0 text-[11px] text-muted">pp. {pageRange(article.pages)}</span>
  </div>
  <p class="mt-1.5 text-[12px] leading-relaxed text-muted">
    {authorLine(article.authors, 6)}
  </p>
  <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-muted">
    <span>{article.type}</span>
    {article.doi && (
      <a
        href={article.doi}
        target="_blank"
        rel="noopener"
        class="text-accent underline decoration-accent/30 underline-offset-2 hover:decoration-accent"
      >
        {doiLabel(article.doi)}
      </a>
    )}
    <a href={articleUrl(article)} class="underline decoration-line underline-offset-2 transition hover:text-ink hover:decoration-ink">
      Ver artículo
    </a>
    <a href={article.pdf} data-sample-doc class="underline decoration-line underline-offset-2 transition hover:text-ink hover:decoration-ink">
      PDF
    </a>
    <a href={article.html} data-sample-doc class="underline decoration-line underline-offset-2 transition hover:text-ink hover:decoration-ink">
      HTML
    </a>
  </div>
</li>
