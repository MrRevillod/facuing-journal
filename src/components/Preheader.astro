---
import { preheaderLinks, preheaderSocial } from "../data/preheader";
---

<div class="shrink-0 bg-corp-blue text-white">
  <div class="mx-auto flex h-[38px] max-w-6xl items-center px-4 sm:px-6">
    <nav
      aria-label="Enlaces institucionales UCT"
      class="min-w-0 flex-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      <ul class="flex w-max min-w-full items-center whitespace-nowrap">
        {
          preheaderLinks.map((link, index) => (
            <li class="flex items-center">
              {index > 0 && (
                <span aria-hidden="true" class="h-3.5 w-px shrink-0 bg-white/50" />
              )}
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer"
                class="inline-flex h-[38px] items-center gap-1.5 px-2.5 text-[12px] transition hover:bg-white/10 focus-visible:outline-white sm:px-3 lg:px-2.5 xl:px-3.5 xl:text-[13px]"
              >
                {link.live && (
                  <img
                    src="/assets/vivo.gif"
                    alt=""
                    width="15"
                    height="11"
                    class="h-[11px] w-[15px]"
                  />
                )}
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="ml-auto flex items-center gap-0.5 pl-2 sm:pl-3">
          {
            preheaderSocial.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noreferrer"
                aria-label={item.label}
                title={item.label}
                class="inline-flex size-7 items-center justify-center text-white/85 transition hover:text-white focus-visible:outline-white"
              >
                <svg viewBox={item.viewBox} class="size-4 fill-current" aria-hidden="true">
                  <path d={item.path} />
                </svg>
              </a>
            ))
          }
        </li>
      </ul>
    </nav>
  </div>
</div>
