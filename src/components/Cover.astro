---
import type { Issue } from "../data/journal";
import { issueUrl } from "../lib/journal";

interface Props {
  issue: Issue;
  link?: boolean;
  class?: string;
}

const { issue, link = true, class: className = "" } = Astro.props;
const Tag = link ? "a" : "div";
---

<Tag href={link ? issueUrl(issue) : undefined} class:list={["block", link && "group", className]}>
  <div
    class="relative flex aspect-[3/4] flex-col justify-between overflow-hidden border border-ink/15 bg-ink p-5 text-paper"
  >
    <span class="absolute inset-x-0 top-0 flex h-1">
      <span class="h-full w-1/2 bg-accent"></span>
      <span class="h-full w-1/2 bg-corp-yellow"></span>
    </span>
    <div class="flex items-start justify-between gap-2 text-[10px] uppercase leading-tight tracking-[0.16em] text-paper/70">
      <span>Revista de Ingeniería</span>
      <span>UCT</span>
    </div>
    <div>
      <p class="font-serif text-[40px] leading-none">Vol. {issue.volume}</p>
      <p class="mt-1 font-serif text-[27px] leading-none">Núm. {issue.number}</p>
    </div>
    <div class="flex items-end justify-between gap-3 text-[11px] uppercase tracking-[0.14em] text-paper/70">
      <span>{issue.year}</span>
    </div>
  </div>
</Tag>
